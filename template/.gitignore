# Keep editor, operating system, and personal tooling ignores in your global
# git ignore.  Entries here are specific to this project, and each one carries
# a comment that justifies it.

# Ignore cargo generated build artifacts.
target/

# Elm build cache.
frontend/elm-stuff/

# Compiled Elm bundle (generated by elm-make; not checked in).
frontend/public/elm.js

# Claude Code project config is part of the project and must be checked in.  A
# user-global or system-wide ignore (e.g. /etc/gitignore) often excludes
# .claude/ wholesale; re-include it.  Personal overrides go in
# .claude/settings.local.json, which Claude Code itself treats as the local-only
# file — that one stays ignored below.
!.claude/
.claude/settings.local.json

# The review tool's per-file review record.  It is machine-local state about an
# uncommitted working tree.
review.json*
